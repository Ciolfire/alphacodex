<UserControl x:Class="AlphaCodex.ClassesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AlphaCodex"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200">
    <DockPanel x:Name="ClassesLayout">
        <Border>
            <Border.Background>
                <ImageBrush ImageSource="/AlphaCodex;component/data/pictures/UI/feats/light_back.jpg" Stretch="UniformToFill"/>
            </Border.Background>
            <ListBox Name="ClassesListBox" ItemsSource="{Binding Path=Classes}" HorizontalContentAlignment="Stretch"  Width="360" MinWidth="360" MaxWidth="510" SelectionChanged="ClassesBox_SelectionChanged" BorderBrush="Black" VirtualizingPanel.IsVirtualizing="true" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.VerticalScrollBarVisibility="Visible" >
            <ListBox.Background>
                <ImageBrush ImageSource="/AlphaCodex;component/data/pictures/UI/feats/back_list.png" Stretch="Uniform"/>
            </ListBox.Background>
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Padding" Value="0,0,0,0"/>
                    <Setter Property="Visibility" Value="{Binding Path=Visibility}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MaxWidth="{Binding ActualWidth, ElementName=ClassesListBox, Mode=OneWay}" Margin="0"  Height="100" Cursor="Hand">
                        <Grid.Background>
                            <ImageBrush ImageSource="/AlphaCodex;component/data/pictures/UI/feats/back_item2.png" Stretch="Fill"/>
                        </Grid.Background>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Path=Name}" TextTrimming="CharacterEllipsis" FontFamily="/AlphaCodex;component/data/#Celestia Antiqua" FontSize="20" Grid.Row="0" Grid.Column="0" Margin="20,15,0,0" Background="{x:Null}" Foreground="#FF003364" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Path=Role}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" FontFamily="Buxton Sketch" FontSize="15" FontWeight="Medium" Grid.Row="1" Grid.Column="0" Margin="20,0,0,4" Foreground="#FF322720"/>
                        <!--<Image Source="{Binding Path=SubtypePicture}" Grid.RowSpan="2" Grid.Column="1" Margin="0,5,2,2" HorizontalAlignment="Right" VerticalAlignment="Center" MaxHeight="50" MaxWidth="50"/>
                        <Image Source="{Binding Path=TypePicture, FallbackValue={StaticResource DefaultType}, TargetNullValue={StaticResource DefaultType}}" Grid.RowSpan="2" Grid.Column="1" Margin="0,5,2,2" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>-->
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Background>
                <ImageBrush TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,894,894" ImageSource="/AlphaCodex;component/data/pictures/UI/textures/stone_wall_texture.jpg"/>
            </ScrollViewer.Background>
            <!-- CLASS BOX -->
            <Border Name="ClassBox" DataContext="{Binding Path=DefaultClass}" BorderThickness="2,0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0" Padding="0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Path=Name}" Margin="0,10" Padding="10,10,10,10" FontFamily="/AlphaCodex;component/data/#Celestia Antiqua" FontSize="40" TextAlignment="Center" TextWrapping="WrapWithOverflow" FontWeight="Bold" Foreground="#FF322720" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Background>
                            <ImageBrush ImageSource="/AlphaCodex;component/data/pictures/UI/feats/back_item.png"/>
                        </TextBlock.Background>
                    </TextBlock>
                    <Border Name="ClassPictureBorder" BorderThickness="3" CornerRadius="3" BorderBrush="#BF4F280D" Height="auto"  Width="auto" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Background>
                            <ImageBrush ImageSource="/AlphaCodex;component/data/pictures/UI/textures/parchment_texture.jpg" TileMode="Tile"/>
                        </Border.Background>
                        <Image Source="{Binding Path=Picture}" MaxHeight="300"/>
                    </Border>
                    <Expander x:Name="Expander" FontFamily="/AlphaCodex;component/data/#Celestia Antiqua" FontSize="20" Foreground="#FF202532" Margin="0,0,0,10" ClipToBounds="True">
                        <Expander.Header >
                            <!-- Width-Binding is needed, to fill the whole header horizontally-->
                            <Grid HorizontalAlignment="Stretch" Margin="0" Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Expander}}, Path=ActualWidth}">
                                <Label Content="DESCRIPTION" FontFamily="/AlphaCodex;component/data/#Celestia Antiqua" FontSize="20" Foreground="#FF202532" HorizontalAlignment="Center" Cursor="Hand" Margin="-53,0,0,0">
                                    <Label.Background>
                                        <ImageBrush ImageSource="/AlphaCodex;component/data/pictures/UI/feats/back_item.png"/>
                                    </Label.Background>
                                </Label>
                            </Grid>
                        </Expander.Header>
                        <Border BorderBrush="#BF4F280D" BorderThickness="2" CornerRadius="4" Margin="50,10,50,0" MaxWidth="1000" HorizontalAlignment="Center" Background="#BFEAE6C3">
                            <StackPanel MaxWidth="{Binding ActualWidth, ElementName=Expander, Mode=OneWay}">
                                <StackPanel.Resources>
                                    <Style BasedOn="{StaticResource tbSpStyle}" TargetType="{x:Type TextBlock}" />
                                </StackPanel.Resources>
                                <TextBlock Text="{Binding Path=Description}" Margin="20,10,20,10"/>
                                <TextBlock Name="ClassAdventuresHeader" Text="Adventures:" FontWeight="Bold" Margin="20,10,20,0"/>
                                <TextBlock Text="{Binding Path=Adventures}"/>
                                <TextBlock Name="ClassCharacteristicsHeader" Text="Characteristics:" FontWeight="Bold" Margin="20,10,20,0"/>
                                <TextBlock Text="{Binding Path=Characteristics}"/>
                                <TextBlock Name="ClassRlignmentHeader" Text="Alignment:" FontWeight="Bold" Margin="20,10,20,0"/>
                                <TextBlock Text="{Binding Path=Alignment}"/>
                                <TextBlock Name="ClassReligionHeader" Text="Religion:" FontWeight="Bold" Margin="20,10,20,0"/>
                                <TextBlock Text="{Binding Path=Religion}"/>
                                <TextBlock Name="ClassBackgroundHeader" Text="Background:" FontWeight="Bold" Margin="20,10,20,0"/>
                                <TextBlock Text="{Binding Path=Background}"/>
                                <TextBlock Name="ClassRacesHeader" Text="Races:" FontWeight="Bold" Margin="20,10,20,0"/>
                                <TextBlock Text="{Binding Path=Races}"/>
                                <TextBlock Name="ClassOtherClassesHeader" Text="Other Classes:" FontWeight="Bold" Margin="20,10,20,0"/>
                                <TextBlock Text="{Binding Path=Other_classes}"/>
                                <TextBlock Name="ClassRoleHeader" Text="Role:" FontWeight="Bold" Margin="20,10,20,0"/>
                                <TextBlock Text="{Binding Path=Role}"/>
                            </StackPanel>
                        </Border>
                    </Expander>
                    <StackPanel Width="500" HorizontalAlignment="Center">
                        <StackPanel.Background>
                            <ImageBrush ImageSource="/AlphaCodex;component/data/pictures/UI/feats/back_item.png"/>
                        </StackPanel.Background>
                        <StackPanel.Resources>
                            <Style BasedOn="{StaticResource tbSpStyle2}" TargetType="{x:Type TextBlock}" />
                        </StackPanel.Resources>
                        <TextBlock Text="GAME RULE INFORMATION" FontSize="20" Margin="20,50,20,5" HorizontalAlignment="Center"/>
                        <TextBlock Name="ClassIntroduction"/>
                        <TextBlock Name="ClassAbilitiesHeader" Text="Abilties:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Path=Abilities}"/>
                        <TextBlock Name="ClassAlignmentRestrictionHeader" Text="Alignment:" FontWeight="Bold"/>
                        <TextBlock Name="ClassAlignmentRestriction"/>
                        <TextBlock Name="ClassHitDieHeader" Text="Hit Die:" FontWeight="Bold"/>
                        <TextBlock Name="ClassHitDie" Margin="50,5,50,50"/>
                    </StackPanel>
                    <Border BorderBrush="#BF4F280D" BorderThickness="2" CornerRadius="4" Margin="20,5" HorizontalAlignment="Center" Background="#BFEAE6C3">
                        <DataGrid Name="ClassTable" Style="{StaticResource tableStyle}" ItemsSource="{Binding}" FrozenColumnCount="1" GridLinesVisibility="None" Padding="0" Margin="0" VerticalScrollBarVisibility="Disabled" BorderThickness="15,18,15,25" BorderBrush="{x:Null}"/>
                    </Border>
                    <Border x:Name="ClassSpells" BorderBrush="#BF4F280D" BorderThickness="2" CornerRadius="4" Margin="20,5" HorizontalAlignment="Center" Background="#BFEAE6C3">
                        <Grid x:Name="SpellsGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" x:Name="ClassSpellsDaily">
                                <TextBlock Margin="0,10,0,-20" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="/AlphaCodex;component/data/#Celestia Antiqua">Spells per Day</TextBlock>
                                <DataGrid Name="ClassSpellsDailyTable" Style="{StaticResource tableStyle}" ItemsSource="{Binding}" FrozenColumnCount="1" GridLinesVisibility="None" Padding="0" Margin="0" VerticalScrollBarVisibility="Disabled" BorderThickness="15,18,15,25" MaxWidth="{Binding MaxWidth, ElementName=ClassSpellsDaily, Mode=OneWay}" BorderBrush="{x:Null}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" x:Name="ClassSpellsKnown" Margin="-25,0,0,0">
                                <TextBlock Margin="0,10,0,-20" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="/AlphaCodex;component/data/#Celestia Antiqua">Spells Known</TextBlock>
                                <DataGrid Name="ClassSpellsKnownTable" Style="{StaticResource tableStyle}" ItemsSource="{Binding}" GridLinesVisibility="None" Padding="0" Margin="0" VerticalScrollBarVisibility="Disabled" BorderThickness="15,18,15,25" BorderBrush="{x:Null}" MaxWidth="{Binding MaxWidth, ElementName=ClassSpellsKnown, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border BorderThickness="2" Margin="20,5" CornerRadius="5" Background="#BFEAE6C3" BorderBrush="#BF4F280D">
                        <StackPanel MaxWidth="{Binding ActualWidth, ElementName=Expander, Mode=OneWay}">
                            <StackPanel.Resources>
                                <Style BasedOn="{StaticResource tbSpStyle2}" TargetType="{x:Type TextBlock}" />
                            </StackPanel.Resources>
                            <TextBlock Text="Class Skills:" FontSize="18" FontWeight="Bold" Margin="20,10,20,0"/>
                            <TextBlock Name="ClassSkills"/>
                            <TextBlock Text="Class Features:" FontSize="18" FontWeight="Bold" Margin="20,10,20,0"/>
                            <TextBlock Name="ClassFeatures"/>
                            <TextBlock Name="ClassExFieldTitle" FontSize="18" FontWeight="Bold" Margin="20,10,20,0"/>
                            <TextBlock Name="ClassExField"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <!-- CLASS RIGHT PANEL -->
    </DockPanel>
</UserControl>
