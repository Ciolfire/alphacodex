<UserControl x:Class="AlphaCodex.Views.FavoriteGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AlphaCodex.Views"
             xmlns:tools="clr-namespace:AlphaCodex.Tools"
             mc:Ignorable="d">
    <StackPanel VerticalAlignment="Top" Width="220" Margin="5" Background="#FF230F0F" HorizontalAlignment="Left">
        <StackPanel Height="200" MaxHeight="200">
            <TextBlock Visibility="{Binding Path=Name, Converter={tools:NullToVisibilityConverter}}"
                       Text="{Binding Path=Name}" TextAlignment="Center" 
                       FontFamily="{DynamicResource MainFont}" FontWeight="Bold" FontSize="18"
                       Foreground="#E5FFF1B4"/>
            <ListBox ItemsSource="{Binding Path=Favorites}"
                     Style="{DynamicResource ListBoxStyleFeats}"
                     MinHeight="179" MaxHeight="200"
                     SelectionMode="Multiple"
                     ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="#E5FFF1B4">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <local:FavoriteView/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
        <Button Background="#FF6E0000" Foreground="White">Delete</Button>
        <Button Background="#FF033504" Foreground="White">Duplicate</Button>
        </StackPanel>
    </StackPanel>
</UserControl>
