<UserControl x:Class="AlphaCodex.Views.FavoriteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AlphaCodex.Views"
             mc:Ignorable="d">
    <StackPanel Orientation="Horizontal"
                Cursor="Hand"
                Background="{DynamicResource BorderColor}">
        <TextBlock Grid.Column="0" 
                   Width="168"
                   Text="{Binding Path=DisplayName}" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TitleColor}" Background="{DynamicResource BackgroundColor}"
                   ToolTip="{Binding Path=DisplayName}" 
                   Margin="1,1,0,1" Padding="1"/>
        <Button Width="19" Margin="0,1,1,1" Background="#FF650A0A" Command="{Binding Path=NavigateCommand}">-</Button>
    </StackPanel>
</UserControl>
