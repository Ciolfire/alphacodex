<UserControl x:Class="AlphaCodex.Views.BooksViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AlphaCodex.Views"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="510">
    <UserControl.Resources>
        <BitmapImage x:Key='defaultBook' UriSource="/AlphaCodex;component/data/pictures/books/none.jpg"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding Books}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,20,0,0" Background="#FF150D09" Style="{DynamicResource ListBoxStyleFeats}" BorderBrush="{x:Null}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ListBoxItem Padding="0">
                        <Border BorderThickness="2" Margin="-2" BorderBrush="#FF640000" CornerRadius="2" >
                            <StackPanel Height="160" Width="109" Background="#FFF1EBB9">
                                <Grid Width="109" Height="100" Margin="0, 5, 0, 0">
                                    <Border BorderThickness="2" BorderBrush="{DynamicResource BorderColor}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image Source="{Binding Path=Cover, FallbackValue={StaticResource defaultBook}}"/>
                                    </Border>
                                    <Border BorderThickness="2" BorderBrush="{DynamicResource BorderColor}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <local:CommandControl Command="{Binding Path=SwitchActivationCommand}" Cursor="Hand">
                                            <Image Opacity="{Binding Path=IsDisabled}"
                                               Source="/AlphaCodex;component/data/pictures/UI/thumbnails/books/book_deactivated.png"/>
                                        </local:CommandControl>
                                    </Border>
                                </Grid>
                                <Border Height="55">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                                               FontFamily="{StaticResource MainFont}" FontSize="16"
                                               Foreground="{StaticResource TitleColor}"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ListBoxItem>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Command="{Binding SelectSpecificBooksCommand}" CommandParameter="FR" 
                    Width="102" Cursor="Hand" BorderThickness="1,1,1,0"
                    Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource BorderColor}" BorderBrush="Black">Forgotten Realms</Button>
            <Button Command="{Binding SelectSpecificBooksCommand}" CommandParameter="EB" 
                    Width="102" Cursor="Hand" BorderThickness="1,1,1,0"
                    Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource BorderColor}" BorderBrush="Black">Eberron</Button>
            <Button Command="{Binding SelectSpecificBooksCommand}" CommandParameter="DL" 
                    Width="102" Cursor="Hand" BorderThickness="1,1,1,0"
                    Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource BorderColor}" BorderBrush="Black">Dragonlance</Button>
            <Button Command="{Binding SelectSpecificBooksCommand}" CommandParameter="other" 
                    Width="102" Cursor="Hand" BorderThickness="1,1,1,0"
                    Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource BorderColor}" BorderBrush="Black">Others</Button>
            <Button Command="{Binding SelectSpecificBooksCommand}" CommandParameter="core"
                    Width="102" Cursor="Hand" BorderThickness="1,1,1,0"
                    Background="{DynamicResource BorderColor}" Foreground="{DynamicResource BackgroundColor}" BorderBrush="Black">Core only</Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Command="{Binding ActivateAllBooksCommand}" 
                    Width="255" Cursor="Hand" BorderThickness="1,1,1,0"
                    Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource BorderColor}" BorderBrush="Black">Select All</Button>
            <Button Command="{Binding DeactivateAllBooksCommand}"
                    Width="255" Cursor="Hand" BorderThickness="1,1,1,0"
                    Background="{DynamicResource BorderColor}" Foreground="{DynamicResource BackgroundColor}" BorderBrush="Black">Deselect All</Button>
        </StackPanel>
    </Grid>
</UserControl>
