<UserControl x:Class="AlphaCodex.Views.FeatListItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AlphaCodex.Views"
             mc:Ignorable="d" 
             d:DesignHeight="110" d:DesignWidth="360" Visibility="{Binding Path=Visibility}">
    <local:CommandControl Command="{Binding Path=SelectCommand}" Height="110" Cursor="Hand">
        <DockPanel>
            <DockPanel.Background>
                <ImageBrush ImageSource="/AlphaCodex;component/data/pictures/UI/feats/back_item.png" Stretch="Fill"/>
            </DockPanel.Background>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Path=Name}" FontFamily="{StaticResource MainFont}" Foreground="{StaticResource TitleColor}" FontSize="20" Margin="10,5,5,5" FontWeight="Bold" TextAlignment="Center"/>
            <Grid DockPanel.Dock="Right" Margin="0,0,10,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="10"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Path=Subtype.Picture}" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="2"/>
                <Image Source="{Binding Path=Type.Picture}" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="2"/>
            </Grid>
            <TextBlock Text="{Binding Path=Info}" FontFamily="{StaticResource SecondaryFont}" Foreground="{StaticResource TextColor}" FontWeight="Medium" FontSize="15" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="10,5,5,5"/>
        </DockPanel>
    </local:CommandControl>
</UserControl>
