<UserControl x:Class="AlphaCodex.Views.FeatSubtypesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AlphaCodex.Views"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="510">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding Path=Subtypes}" Grid.Row="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,20,0,0" Background="{DynamicResource BackgroundColor2}" Style="{DynamicResource ListBoxStyleFeats}" BorderBrush="Black">
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <ListBoxItem Padding="0">
                    <Border BorderThickness="2" Margin="-2" BorderBrush="#FF640000" CornerRadius="2" >
                        <StackPanel Height="130" Width="150" Background="#FFF1EBB9">
                            <Grid Width="100" Height="100" Margin="0, 5, 0, 0">
                                <Image Source="{Binding Path=Picture}" VerticalAlignment="Center" />
                                    <local:CommandControl Command="{Binding Path=SwitchActivationCommand}" Cursor="Hand">
                                        <Image Opacity="{Binding Path=IsDisabled}"
                                               Source="/AlphaCodex;component/data/pictures/UI/feats/subtype/deactivate.png"/>
                                    </local:CommandControl>
                                </Grid>
                            <TextBlock Text="{Binding Path=Name}" FontSize="16" FontFamily="/AlphaCodex;component/data/#Celestia Antiqua" TextAlignment="Center" Margin="5,1,5,5" Foreground="#FF003364"/>
                        </StackPanel>
                    </Border>
                </ListBoxItem>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="1" Orientation="Horizontal">
        <Button Command="{Binding ActivateAllSubtypesCommand}"
                Width="255" Cursor="Hand"
                Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource BorderColor}">Select All</Button>
        <Button Command="{Binding DeactivateAllSubtypesCommand}"
                Width="255" Cursor="Hand"
                Background="{DynamicResource BorderColor}" Foreground="{DynamicResource BackgroundColor}">Deselect All</Button>
    </StackPanel>
</Grid>
</UserControl>
