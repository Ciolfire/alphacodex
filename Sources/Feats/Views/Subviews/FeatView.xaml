                        <Border  MouseLeave="FeatOptions_MouseLeave" Name="FeatOptionsBlock" BorderBrush="#FF760000" CornerRadius="2" BorderThickness="2" Cursor="Hand" Panel.ZIndex="1" VerticalAlignment="Top" HorizontalAlignment="Right" Visibility="Collapsed" Margin="0,5,5,0" Background="#BFFFEA91">
