<UserControl x:Class="AlphaCodex.Views.FeatTypesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AlphaCodex.Views"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="510">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding Types}" Style="{DynamicResource ListBoxStyleFeats}"
                 Grid.Row="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Margin="0,20,0,0"
                 Background="{DynamicResource BackgroundColor2}" BorderBrush="black">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ListBoxItem Padding="0">
                        <Border BorderThickness="2" Margin="-2" BorderBrush="#FF640000" CornerRadius="2" >
                            <StackPanel Height="150" Width="109" Background="#FFF1EBB9">
                                <Grid Width="100" Height="100" Margin="0, 5, 0, 0">
                                    <Image Source="{Binding Path=Picture}"/>
                                    <local:CommandControl Command="{Binding Path=SwitchActivationCommand}" Cursor="Hand">
                                        <Image Opacity="{Binding Path=IsDisabled}"
                                               Source="/AlphaCodex;component/data/pictures/UI/feats/type/deactivate.png"/>
                                    </local:CommandControl>
                                    <!--<Hyperlink.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding Path=SwitchActivationCommand}"/>
                                            <MouseBinding Gesture="RightClick" Command="{Binding Path=SwitchActivationCommand}" CommandParameter="{Binding}"/>
                                        </Hyperlink.InputBindings>-->
                                </Grid>
                                <Border Height="50">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                                               FontFamily="{StaticResource MainFont}" FontSize="16"
                                               Foreground="{StaticResource TitleColor}"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ListBoxItem>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Command="{Binding ActivateAllTypesCommand}"
                    Width="255" Cursor="Hand" BorderThickness="1,0"
                    Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource BorderColor}" BorderBrush="Black">Select All</Button>
            <Button Command="{Binding DeactivateAllTypesCommand}"
                    Width="255" Cursor="Hand" BorderThickness="1,0"
                    Background="{DynamicResource BorderColor}" Foreground="{DynamicResource BackgroundColor}" BorderBrush="Black">Deselect All</Button>
        </StackPanel>
    </Grid>
</UserControl>
