<UserControl x:Class="AlphaCodex.Views.FavoritesMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AlphaCodex.Views"
             xmlns:main="clr-namespace:AlphaCodex"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Background="{DynamicResource BorderColor}" Click="FavoriteButton_Click" Grid.Column="1" Grid.Row="0" BorderBrush="{x:Null}" Foreground="Black" FontWeight="Bold">
            <StackPanel Orientation="Horizontal">
                <Image Source="/AlphaCodex;component/data/pictures/UI/favorite_on.png"/>
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Favorites Menu" FontWeight="Normal" Foreground="{DynamicResource BackgroundColor}" TextAlignment="Center"/>
            </StackPanel>
        </Button>
        <ScrollViewer Template="{DynamicResource ScrollViewerControlTemplate}" VerticalScrollBarVisibility="Visible" Grid.Row="1" Grid.ColumnSpan="2">
            <ItemsControl ItemsSource="{Binding Path=Root.PlayerVM.FavoriteGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type main:MainWindow}}, Path=DataContext.PlayerVM.AddFavoriteCommand}" CommandParameter="{Binding Path=Id}" Content="{Binding Path=DisplayName}" Background="{DynamicResource BackgroundColor}" BorderBrush="{DynamicResource BorderColor}">
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
