<UserControl x:Class="AlphaCodex.Views.FeatPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AlphaCodex.Views"
             xmlns:tools="clr-namespace:AlphaCodex.Tools"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1360">
    <DockPanel Background="#FF640000">
        <Expander ExpandDirection="Left" IsExpanded="True"
                  Style="{DynamicResource ExpanderStyleSearch}">
            <Grid Width="510" MinWidth="360" MaxWidth="510">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="Black" BorderThickness="1,1,1,0"
                        Margin="0,0,0,0">
                    <StackPanel Grid.Row="0"
                                Background="{DynamicResource BackgroundColor}">
                        <StackPanel Orientation="Horizontal"
                                    Margin="10, 0">
                            <Label Content="Search"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleColor}"
                                   Width="280"/>
                            <RadioButton IsChecked="{Binding Path=SearchMode, Converter={tools:FeatSearchToBoolConverter}, ConverterParameter=Name}" 
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource TitleColor}" BorderBrush="{DynamicResource TitleColor}" Background="#33FFFFFF"
                                         Margin="0,0,5,0">Name
                            </RadioButton>
                            <RadioButton IsChecked="{Binding Path=SearchMode, Converter={tools:FeatSearchToBoolConverter}, ConverterParameter=Benefit}"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource TitleColor}" BorderBrush="{DynamicResource TitleColor}" Background="#33FFFFFF"
                                         Margin="0,0,5,0">Benefit
                            </RadioButton>
                            <RadioButton IsChecked="{Binding Path=SearchMode, Converter={tools:FeatSearchToBoolConverter}, ConverterParameter=Prerequisite}"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource TitleColor}" BorderBrush="{DynamicResource TitleColor}" Background="#33FFFFFF"
                                         Margin="0,0,5,0">Prerequisite
                            </RadioButton>
                        </StackPanel>
                        <TextBox Text="{Binding Path=ToFind, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MainFont}" FontSize="24"
                                 Margin="10,0,10,10" Height="26"
                                 Background="#33FFFFFF" BorderBrush="{DynamicResource BorderColor}" CaretBrush="{DynamicResource BorderColor}" Foreground="{DynamicResource BorderColor}" SelectionBrush="#7FD14A4A"
                                 BorderThickness="1"
                                 HorizontalContentAlignment="Center"
                                 Style="{DynamicResource TextBoxStyleSearch}">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </Border>
                <TabControl Grid.Row="1"
                            Padding="0"
                            BorderBrush="{x:Null}" Background="{x:Null}"
                            Style="{DynamicResource TabControlStyleFeat}">
                    <TabItem Header="Types"
                             Background="#FFF1EBB9" BorderBrush="#FF211B12" Foreground="#FF640000"
                             Style="{DynamicResource TabItemStyleFeats}">
                        <local:FeatTypesView/>
                    </TabItem>
                    <TabItem Header="Categories"
                             Background="#FFF1EBB9" BorderBrush="#FF211B12" Foreground="#FF640000"
                             Style="{DynamicResource TabItemStyleFeats}">
                        <local:FeatSubtypesView/>
                    </TabItem>
                    <TabItem Header="Books"
                             Background="#FFF1EBB9" BorderBrush="#FF211B12" Foreground="#FF640000"
                             Style="{DynamicResource TabItemStyleFeats}">
                        <local:BooksViewModel/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Expander>
        <Border Background="#FF211B12">
            <local:FeatsView/>
        </Border>
        <Border DockPanel.Dock="Right">
            <Border.Background>
                <ImageBrush ImageSource="/AlphaCodex;component/data/pictures/UI/feats/central_back.jpg"/>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          Template="{DynamicResource ScrollViewerControlTemplate}">
                    <local:FeatView/>
                </ScrollViewer>
                <Grid Grid.Row="1" Height="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding ActivateAllTypesCommand}"
                            Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource BorderColor}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/AlphaCodex;component/data/pictures/UI/copy_img.png"/>
                            <TextBlock>Copy as Picture</TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Command="{Binding ActivateAllTypesCommand}"
                            Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource BorderColor}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/AlphaCodex;component/data/pictures/UI/copy_text.png"/>
                            <TextBlock>Copy as Text</TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding DeactivateAllTypesCommand}"
                            Background="{DynamicResource BorderColor}" Foreground="{DynamicResource BackgroundColor}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/AlphaCodex;component/data/pictures/UI/favorite_off.png"/>
                            <TextBlock>Add Favorite...</TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
