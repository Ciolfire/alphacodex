<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Properties="clr-namespace:AlphaCodex.Properties" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlphaCodex"
        mc:Ignorable="d" x:Name="Main_Window" x:Class="AlphaCodex.MainWindow"
        Title="Alpha Codex" Width="1360" Height="768" WindowStartupLocation="CenterScreen" MinHeight="768" >
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AlphaCodex;component/CodexDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="mainGrid" Background="BlanchedAlmond">
        <Border x:Name="Welcome" Panel.ZIndex="1" BorderBrush="#FF392F21" BorderThickness="5" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <DockPanel Height="150" Width="300">
                <Label FontFamily="/AlphaCodex;component/data/#Celestia Antiqua" FontSize="30" Height="50" DockPanel.Dock="Top" Content="Please choose a name" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#7FF6E4BC"/>
                <TextBox x:Name="WelcomeTextBox" TextChanged="WelcomeTextBox_TextChanged" FontFamily="/AlphaCodex;component/data/#Celestia Antiqua" FontSize="30" Height="50" DockPanel.Dock="Top" Background="#7FD3B182" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <Button x:Name="WelcomeButton" Click="WelcomeButton_Click" IsEnabled="False" FontFamily="/AlphaCodex;component/data/#Celestia Antiqua" FontSize="30" Height="50" DockPanel.Dock="Bottom" Content="Continue" Background="#BF473329" VerticalContentAlignment="Center" Foreground="#FF8B8B8B"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="menu" Height="auto" Width="auto" SelectedIndex="3" IsEnabled="False" Style="{DynamicResource TabControlStyleMain}">
            <TabItem x:Name="homePanel" Header="Home" Style="{DynamicResource TabItemStyleMain}">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                        <GradientStop Color="#FFF0F0F0" Offset="0"/>
                        <GradientStop Color="#FF211B12" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <Grid>
                    <Grid.Background>
                        <ImageBrush ImageSource="data/pictures/UI/home/background.jpg"/>
                    </Grid.Background>
                </Grid>
            </TabItem>
            <TabItem x:Name="RacesPanel" Header="Races" Style="{DynamicResource TabItemStyleMain}">
                <Grid x:Name="Races" Background="#FFA8B2B6">
                    <ComboBox x:Name="cb" Margin="10,10,10,911"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="ClassesPanel"
                     Header="Classes"
                     Initialized="ClassesPanel_Initialized" Style="{DynamicResource TabItemStyleMain}">
                <local:ClassesPanel/>
            </TabItem>
            <TabItem x:Name="FeatPanel"
                     Header="Feats"
                     Initialized="FeatPanel_Initialized" Style="{DynamicResource TabItemStyleMain}">
                <local:FeatPanel/>
            </TabItem>
            <TabItem x:Name="spellPanel"
                     Header="Spells"
                     Loaded="spellPanel_Loaded" Style="{DynamicResource TabItemStyleMain}">
            </TabItem>
            <TabItem x:Name="convPanel" Header="Conv" Style="{DynamicResource TabItemStyleMain}">
                <Grid x:Name="conv" Background="#FFB9B9B9"/>
            </TabItem>
            <TabItem x:Name="ajouts"  Header="Ajouts" Initialized="AddFeatsPanel_Initialized" Style="{DynamicResource TabItemStyleMain}">
                <Grid>
                    <Button x:Name="createPrerequisiteBtn" Content="Generate feats prerequisites" HorizontalAlignment="Left" Margin="48,213,0,0" VerticalAlignment="Top" Width="155" Height="103" Click="CreatePrerequisiteBtn_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
